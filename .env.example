# Ghost Reader environment template.
# Copy to .env for Docker Compose, or use these values in backend/.env for local development.
# Never commit the real .env file.

# Backend
GR_ENVIRONMENT=development
# Required for any shared or production deployment. Generate with: openssl rand -hex 32
GR_SECRET_KEY=
GR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GR_STORAGE_DIR=./data
GR_OCR_LANGUAGES=eng+kan
GR_LOG_LEVEL=INFO

# Docker Compose production edge (TLS + authentication through Caddy).
# Use a DNS name that points at this host for automatic HTTPS. Use "localhost"
# only for local testing; Caddy will issue an untrusted internal certificate.
GR_DOMAIN=localhost
GR_AUTH_USER=reader
# Generate with:
# docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext 'choose-a-strong-password'
# Keep the hash in single quotes so Compose does not expand the "$" characters.
GR_AUTH_PASSWORD_HASH=''

# Optional OCR override when tesseract is not on PATH.
# GR_TESSERACT_CMD=/usr/bin/tesseract

# Optional Redis-backed jobs and isolated browser fallback.
# GR_REDIS_URL=redis://localhost:6379/0
# GR_USE_WORKER_QUEUE=false
# GR_ENABLE_BROWSER_FALLBACK=false

# Optional tuning
# GR_JOB_TTL_SECONDS=1800
# GR_MAX_CONCURRENT_JOBS=2
# GR_MAX_UPLOAD_BYTES=40000000
# GR_MAX_PDF_PAGES=80
# GR_MAX_NEWSPAPER_PAGES=64
# GR_RATE_LIMIT_PER_MINUTE=90
# GR_ANALYZE_RATE_LIMIT_PER_MINUTE=20
# GR_UPLOAD_RATE_LIMIT_PER_MINUTE=12

# Frontend public configuration (inlined by Next.js at build time).
# For local development, copy these into frontend/.env.local.
# For Docker Compose, leave NEXT_PUBLIC_API_URL empty so requests use the
# same origin through Caddy, and set NEXT_PUBLIC_SITE_URL to https://<GR_DOMAIN>.
# Local frontend development uses frontend/.env.example instead.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://localhost
