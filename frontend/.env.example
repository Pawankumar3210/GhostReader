# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are embedded into the client bundle at build time.
# Docker Compose builds with an empty API URL so requests stay same-origin
# behind Caddy; it sets NEXT_PUBLIC_SITE_URL to https://<GR_DOMAIN>.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
